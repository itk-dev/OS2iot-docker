# DO NOT COMMIT - Create locally, seal with kubeseal
# Copy this file to mosquitto-secret.yaml and fill in real values
apiVersion: v1
kind: Secret
metadata:
  name: mosquitto-secrets
  namespace: os2iot
type: Opaque
stringData:
  # MQTT Authentication (for mosquitto-os2iot with go-auth plugin)
  MQTT_SUPER_USER: "os2iot-superuser"
  MQTT_SUPER_USER_PASSWORD: "<real-password>"

  # TLS certificates (for mosquitto-os2iot)
data:
  # Base64 encoded certificate files
  server.crt: "<base64-encoded-server-certificate>"
  server.key: "<base64-encoded-server-private-key>"
  ca.crt: "<base64-encoded-ca-certificate>"
