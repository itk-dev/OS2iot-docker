# DO NOT COMMIT - Create locally, seal with kubeseal
# Copy this file to chirpstack-secret.yaml and fill in real values
apiVersion: v1
kind: Secret
metadata:
  name: chirpstack-secrets
  namespace: chirpstack
type: Opaque
stringData:
  # PostgreSQL
  POSTGRES_PASSWORD: "<real-password>"

  # ChirpStack API JWT Secret
  JWT_SECRET: "<random-secret-string>"

  # PostgreSQL connection string (alternative to individual vars)
  # Format: postgres://user:password@host/database?sslmode=disable
  POSTGRES_DSN: "postgres://chirpstack:<real-password>@chirpstack-postgres/chirpstack?sslmode=disable"
