# DO NOT COMMIT - Create locally, seal with kubeseal
# Copy this file to os2iot-secret.yaml and fill in real values
apiVersion: v1
kind: Secret
metadata:
  name: os2iot-secrets
  namespace: os2iot
type: Opaque
stringData:
  # Database
  POSTGRES_PASSWORD: "<real-password>"

  # ChirpStack Integration
  CHIRPSTACK_API_KEY: "<real-api-key>"

  # Encryption
  ENCRYPTION_SYMMETRIC_KEY: "<32-character-key>"
  CA_KEY_PASSWORD: "<real-password>"

  # MQTT
  MQTT_SUPER_USER_PASSWORD: "<real-password>"

  # Email (SMTP)
  EMAIL_USER: "<smtp-username>"
  EMAIL_PASS: "<smtp-password>"

  # KOMBIT (optional)
  KOMBIT_CERTIFICATEPRIVATEKEY: "<base64-encoded-private-key>"
---
# CA certificates secret
apiVersion: v1
kind: Secret
metadata:
  name: ca-keys
  namespace: os2iot
type: Opaque
data:
  # Base64 encoded certificate files
  ca.crt: "<base64-encoded-ca-certificate>"
  ca.key: "<base64-encoded-ca-private-key>"
